{
  "id": "briefingDiario01",
  "name": "briefing-diario",
  "active": false,
  "nodes": [
    {
      "id": "b1a1c001-0000-4000-8000-000000000001",
      "name": "Executar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "b1a1c001-0000-4000-8000-000000000002",
      "name": "Todo dia às 8h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "b1a1c001-0000-4000-8000-000000000003",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a0000001-0000-4000-8000-000000000001",
              "name": "api_base",
              "value": "http://127.0.0.1:8000",
              "type": "string"
            },
            {
              "id": "a0000001-0000-4000-8000-000000000002",
              "name": "data_ref",
              "value": "={{ DateTime.fromISO('2021-01-02').plus({ days: Math.round(DateTime.fromISO($now.setZone('America/Sao_Paulo').toISODate()).diff(DateTime.fromISO('2021-01-02'), 'days').days) % 116 }).toISODate() }}",
              "type": "string"
            },
            {
              "id": "a0000001-0000-4000-8000-000000000006",
              "name": "chat_id",
              "value": "SEU_CHAT_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1a1c001-0000-4000-8000-000000000004",
      "name": "Acordar API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.api_base }}/api/health",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "b1a1c001-0000-4000-8000-000000000005",
      "name": "Buscar briefing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.api_base }}/api/briefing",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "start",
              "value": "={{ $('Config').first().json.data_ref }}"
            },
            {
              "name": "end",
              "value": "={{ $('Config').first().json.data_ref }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "b1a1c001-0000-4000-8000-000000000006",
      "name": "Texto do briefing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        -100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a0000001-0000-4000-8000-000000000003",
              "name": "text",
              "value": "={{ '📋 Briefing de ' + DateTime.fromISO($('Config').first().json.data_ref).toFormat('dd/LL/yyyy') + '\\n\\n' + $json.markdown.replaceAll('**', '*') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1a1c001-0000-4000-8000-000000000007",
      "name": "Telegram: briefing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        -100
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Config').first().json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "webhookId": "b1a1c001-0000-4000-8000-000000000007"
    },
    {
      "id": "b1a1c001-0000-4000-8000-000000000008",
