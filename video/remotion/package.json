{
  "name": "central-operacoes-video",
  "version": "1.0.0",
  "description": "Motion video de 58 s (LinkedIn, 1080 × 1350) da Central de Operações, feito em Remotion",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/google-fonts": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.543",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render LinkedIn ../out/linkedin.mp4 --codec=h264 --crf=16",
    "capa": "remotion still LinkedIn ../out/capa.png --frame=570",
    "render:agente": "remotion render Agente ../out/agente.mp4 --codec=h264 --crf=16",
    "capa:agente": "remotion still Agente ../out/capa-agente.png --frame=780"
  },
  "allowScripts": {
    "esbuild": false
  }
}
