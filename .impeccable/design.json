  "narrative": {
    "northStar": "A comanda na fila",
    "overview": "The console borrows the grammar of the delivery apps its operators already use every day: cool neutral greys, firm sans type, 8px corners, one red that means something. It adds a world of its own taken from the restaurant counter: the thermal **comanda** a store prints when an order arrives. Every alert in the current recorte is a comanda in a queue, numbered, tagged by category and severity, with the action printed at its foot. One comanda is open at a time; the rest wait, summarised.\n\nThe shell is a wine band, not red: it gives the product a recognisable colour field without borrowing any delivery brand's identity, and keeps red free to mean \"critical\". Data series are drawn in a wine ramp, so the charts belong to the same world as the shell.",
    "keyCharacteristics": [
      "Cool grey field (`field`) with white surfaces; layers separate by tone and hairline, never by shadow.",
      "Wine shell band on every theme; signals on the band use their own `shell-*` tokens.",
      "Archivo with a width axis: normal width for reading, condensed caps only for short labels and comanda headers.",
      "Tabular figures everywhere; headline numbers in a narrow bold cut (`figure`).",
      "Red (`crit`) reserved for critical severity and the one primary action in view."
    ],
    "rules": [
      {
        "name": "The One Red Rule",
        "body": "Red marks what is critical or what the operator should press next. Active filters, selected tabs, focus rings and icons use ink, never red.",
        "section": "colors"
      },
      {
        "name": "The Wine Data Rule",
        "body": "A chart series is wine unless it encodes state. Volume, heat and stage ramps are never red.",
        "section": "colors"
      },
      {
        "name": "The One Body Rule",
        "body": "Tables use one text size; header rank comes from condensed caps and weight, never from a bigger size.",
        "section": "typography"
      },
      {
        "name": "The Short Caps Rule",
        "body": "Condensed caps only on labels of a few words. Sentences are never set condensed.",
        "section": "typography"
      },
      {
        "name": "The No Shadow Rule",
        "body": "No box-shadows anywhere, including tooltips and dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every number tabular and every alert closed by an action.",
      "Do use the wine ramp for data and ink for neutral emphasis.",
      "Do encode severity by shape and colour together."
    ],
    "donts": [
      "Don't use red for selection, focus, filters or decorative icons.",
      "Don't put the comanda picket or condensed caps on anything that isn't an alert ticket or a short label.",
      "Don't add shadows, coloured side stripes on cards, or eyebrow labels above headings.",
      "Don't use any delivery company's wordmark, logo, brand red or proprietary typeface."
    ]
  }
