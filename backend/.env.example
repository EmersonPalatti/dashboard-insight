# Opcional: sem chave, o agente usa regras locais e o app funciona igual.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Origens liberadas no CORS (vírgula). Em produção, a URL da Vercel.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Opcional: libera previews da Vercel, ex. ^https://central-operacoes-.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# SLA de ciclo por segmento (min)
SLA_FOOD_MIN=60
SLA_GOOD_MIN=120

# Cota global de chamadas ao LLM por minuto (soma de todos os IPs). 0 desliga.
CHAT_GLOBAL_RATE_LIMIT_PER_MINUTE=60
# Header de IP confiável. Vazio mantém o último hop de X-Forwarded-For.
# A documentação do Render não garante True-Client-IP. Se a Cloudflare estiver na frente, use true-client-ip ou cf-connecting-ip.
CLIENT_IP_HEADER=

# Exportação de pedidos. Acima do teto a API pede um recorte menor.
CSV_EXPORT_MAX_ROWS=50000
CSV_EXPORT_PER_MINUTE=30

# Opcional. Se preenchido, /api/briefing e /api/alerts/routing exigem o header X-Automation-Token.
# O workflow n8n versionado não envia esse header: deixe vazio para ele continuar funcionando.
AUTOMATION_TOKEN=
