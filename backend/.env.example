# Opcional: sem chave, o agente usa regras locais e o app funciona igual.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Origens liberadas no CORS (vírgula). Em produção, a URL da Vercel.
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Opcional: libera previews da Vercel, ex. ^https://central-operacoes-.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# SLA de ciclo por segmento (min)
SLA_FOOD_MIN=60
SLA_GOOD_MIN=120
