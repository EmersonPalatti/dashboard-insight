---
/**
 * Carimbo "Nº": o número que abre cada comanda, num recibo com a borda de baixo picotada.
 * Traço em currentColor; sem animação (a marca não pisca enquanto o operador trabalha).
 */
interface Props {
  class?: string;
  size?: number;
}

const { class: className = "", size = 32 } = Astro.props;
---

<svg
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["shrink-0", className]}
  aria-hidden="true"
>
  <path d="M3 9Q3 5 7 5H25Q29 5 29 9V23L28 25L24 27L20 25L16 27L12 25L8 27L4 25L3 23Z" />
  <path d="M7 23V9L15 23V9" />
  <circle cx="22.5" cy="11.5" r="2" />
  <path d="M19.5 18.5H25.5" />
</svg>
