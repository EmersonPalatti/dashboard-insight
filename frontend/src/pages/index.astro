---
/**
 * Casca estática (zero JS): cabeçalho, seções, rodapé e metodologia.
 * Só o que reage ao recorte vira ilha React:
 *  - client:load    → filtros, trilho de comandas, KPIs (acima da dobra) e o painel do agente
 *                     (leve: a conversa em si carrega sob demanda, mas a barra, o botão
 *                     flutuante e o Ctrl+K funcionam desde o primeiro clique)
 *  - client:visible → gráficos e tabelas (hidratam ao rolar)
 * Moldura, título e dica fixa de cada painel ficam aqui (ui/Panel.astro), fora das ilhas:
 * saem no HTML do build e não somem atrás do skeleton enquanto o JS não chega.
 */
import Base from "@/layouts/Base.astro";
import AgentDock from "@/components/agent/AgentDock";
import AlertsPanel from "@/components/AlertsPanel";
import BreakdownTable from "@/components/BreakdownTable";
import FilterBar from "@/components/FilterBar";
import HeatmapChart from "@/components/HeatmapChart";
import KpiStrip from "@/components/KpiStrip";
import OrdersTable from "@/components/OrdersTable";
import StagesChart from "@/components/StagesChart";
import StoreScatter from "@/components/StoreScatter";
import TopBarStatus from "@/components/TopBarStatus";
import TrendChart from "@/components/TrendChart";
import OpsLogo from "@/components/ui/OpsLogo.astro";
import Panel from "@/components/ui/Panel.astro";

const apiUrl = (import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000").replace(/\/$/, "");
const repoUrl = "https://github.com/EmersonPalatti/dashboard-insight";
---

<Base
  title="Central de Operações"
  description="Painel de operação de delivery com alertas e agente de insights sobre o recorte filtrado. 369 mil pedidos reais do Delivery Center."
>
  <!-- #page: o painel do agente no mobile deixa tudo isto inerte (folha modal) -->
  <div id="page">
    <a class="skip-link" href="#comandas">Pular para as comandas</a>
    <a class="skip-link" href="#filtros">Pular para os filtros</a>
    <!-- no escuro o vinho (#26060F) quase some no campo (#111): um fio de wine-raised marca a borda da faixa -->
    <!-- sm+: 64px com a promessa do recorte. Abaixo de sm: 56px; o nome desce um degrau da escala para caber inteiro. -->
    <header class="h-14 bg-wine text-white sm:h-16 dark:border-b dark:border-wine-raised">
      <div class="mx-auto flex h-full max-w-[1440px] min-w-0 items-center gap-1.5 px-4 sm:gap-3 sm:px-6">
        <div class="flex min-w-0 flex-1 items-center gap-1.5 sm:gap-2.5">
          <OpsLogo size={28} class="text-on-wine" />
          <div class="min-w-0 flex-1">
            <h1 class="header-reveal-title font-slab text-lead leading-tight font-bold text-white sm:truncate sm:text-figure">
              Central de Operações
            </h1>
            <div class="header-reveal-sub mt-0.5 hidden min-w-0 items-center gap-2 sm:flex">
              <p class="min-w-0 truncate text-meta leading-none text-on-wine/90">
                KPIs, comandas e o agente respondem sobre o mesmo recorte.
              </p>
              <span class="hidden shrink-0 items-center gap-1.5 rounded-full border border-on-wine/15 bg-wine-raised/60 px-3 py-1 text-meta leading-none font-medium text-on-wine xl:inline-flex dark:bg-white/10">
                <span>Delivery Center</span>
                <span class="opacity-50">·</span>
                <span class="tabular-nums">jan–abr 2021</span>
                <span class="opacity-50">·</span>
                <span class="tabular-nums font-semibold text-white">368.990 pedidos</span>
              </span>
            </div>
          </div>
        </div>
        <div class="no-print flex shrink-0 items-center gap-1">
          <a class="hit-target relative hidden shrink-0 items-center rounded-card px-2 py-1.5 text-aux text-on-wine transition-colors duration-(--duration-quick) ease-(--ease-smooth-out) hover:bg-wine-raised hover:text-white sm:inline-flex" href={`${apiUrl}/docs`} target="_blank" rel="noopener">API (Swagger)</a>
          <TopBarStatus client:load />
        </div>
      </div>
    </header>

    <p class="mx-auto max-w-[1440px] px-4 pt-3 text-pretty text-aux leading-snug text-ink sm:hidden">
      KPIs, comandas e o agente respondem sobre o mesmo recorte.
    </p>

    <search id="filtros" data-filter-bar aria-label="Filtros do recorte" tabindex="-1" class="no-print sticky top-0 z-20 block border-b border-rule bg-surface">
      <!-- DESIGN: a barra desktop é 80px (40 + 8 + 32). O py-2 só no mobile; no lg ele somava 16px. -->
      <div class="mx-auto max-w-[1440px] px-4 py-2 sm:px-6 lg:py-0">
        <FilterBar client:load />
      </div>
    </search>

    <main class="mx-auto grid max-w-[1440px] grid-cols-[minmax(0,1fr)] gap-5 px-4 pt-5 pb-16 max-lg:pb-24 sm:px-6">
      <!--
        Trilho de comandas no topo: as comandas penduradas lado a lado e a aberta numa faixa larga.
        KPIs e tendência ganham a largura toda logo abaixo. O agente fica fora da grade (AgentDock).
      -->
      <div id="comandas" tabindex="-1" aria-labelledby="comandas-title" class="min-w-0">
        <AlertsPanel client:load />
      </div>

      <KpiStrip client:load />

      <Panel title="Tendência"><TrendChart client:visible /></Panel>

      <!--
        Âncoras dos gráficos que provam uma comanda ("Ver no gráfico"). Ficam na casca porque as
        ilhas só hidratam ao aparecer: o alvo da rolagem precisa existir antes delas.
      -->
      <div class="grid gap-5 lg:grid-cols-2">
        <div id="grafico-etapas" tabindex="-1" class="evidence-anchor grid min-w-0">
          <Panel title="Onde o tempo vai, por hub" hint="Mediana de cada etapa, sem pedidos presos. Clique numa barra para filtrar o hub.">
            <StagesChart client:visible />
          </Panel>
        </div>
        <div id="grafico-dia-hora" tabindex="-1" class="evidence-anchor grid min-w-0">
          <Panel title="Dia × hora"><HeatmapChart client:visible /></Panel>
        </div>
      </div>

      <!--
        Lojas e ranking em linhas próprias. Lado a lado o ranking ficava com ~628px e as
        colunas Preparo, Trânsito e Subsídio saíam do quadro. A ordem de leitura não muda.
      -->
      <div id="grafico-lojas" tabindex="-1" class="evidence-anchor grid min-w-0">
        <Panel title="Lojas: volume × problema" hint="Cada ponto é uma loja com 30+ pedidos; tamanho = GMV. Use a seleção retangular para filtrar um grupo.">
          <StoreScatter client:visible />
        </Panel>
      </div>
      <Panel title="Ranking do recorte"><BreakdownTable client:visible /></Panel>

      <Panel title="Pedidos do recorte"><OrdersTable client:visible /></Panel>
    </main>

    <footer class="border-t border-rule bg-surface">
      <div class="mx-auto grid max-w-[1440px] gap-6 px-4 py-7 text-aux text-muted sm:px-6 md:grid-cols-3">
        <div>
          <p class="text-pretty font-semibold text-ink">Dados</p>
          <p class="text-pretty">
            <a class="hit-target underline decoration-rule underline-offset-4" href="https://www.kaggle.com/datasets/nosbielcs/brazilian-delivery-center" target="_blank" rel="noopener">Delivery Center: Food &amp; Goods orders in Brazil</a> (Kaggle). Nomes de lojas vêm anonimizados no dataset.
          </p>
        </div>
        <div>
          <p class="text-pretty font-semibold text-ink">Como os números são calculados</p>
          <p class="text-pretty">
            Horários convertidos de UTC para Brasília. SLA: food ≤ 60 min, goods ≤ 120 min. Pedidos com ciclo &gt; 4h contam como
            "presos" e ficam fora de medianas e SLA. Valores &gt; R$ 5 mil ficam fora do GMV. A faixa de KPI usa a mesma régua das
            comandas: atenção abaixo de 85% no prazo (crítico abaixo de 80%) e cancelamento acima de 6% (crítico a partir de 9%).
            Recorte menor que a rede compara com a rede no mesmo período; a rede inteira mostra a faixa entre os hubs. Não há meta de SLA em percentual.
            Pedidos, GMV e ticket só comparam período com 100 pedidos ou mais em cada lado.
          </p>
        </div>
        <div>
          <p class="text-pretty font-semibold text-ink">Stack</p>
          <p class="text-pretty">Astro + ilhas React, ECharts, Nanostores, TanStack Query/Table/Virtual · FastAPI, Pydantic, DuckDB sobre Parquet.</p>
          <p class="text-pretty mt-1"><a class="hit-target underline decoration-rule underline-offset-4" href={repoUrl} target="_blank" rel="noopener">Código</a></p>
        </div>
      </div>
    </footer>
  </div>

  <AgentDock client:load />
  <!--
    Painéis client:visible não têm botão até hidratar. Enquanto isso, a moldura entra no Tab
    (o foco rola a seção para a vista e a ilha monta). Com controles dentro, sai da ordem.
  -->
  <script is:inline>
    (function () {
      var bar = document.querySelector("[data-filter-bar]");
      if (!bar || !window.ResizeObserver) return;
      var apply = function () {
        document.documentElement.style.setProperty("--sticky-bar", bar.offsetHeight + "px");
      };
      apply();
      new ResizeObserver(apply).observe(bar);
    })();
  </script>
  <script is:inline>
    (function () {
      var focusable = "a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled])";
      function sync() {
        var sections = document.querySelectorAll("section.panel-frame");
        for (var i = 0; i < sections.length; i++) {
          var section = sections[i];
          var nodes = section.querySelectorAll(focusable);
          var found = false;
          for (var j = 0; j < nodes.length; j++) {
            var el = nodes[j];
            if (el.closest("[aria-hidden='true']") || el.closest("[inert]")) continue;
            found = true;
            break;
          }
          var next = found ? -1 : 0;
          if (section.tabIndex !== next) section.tabIndex = next;
        }
      }
      sync();
      new MutationObserver(sync).observe(document.body, { childList: true, subtree: true });
    })();
  </script>
</Base>
