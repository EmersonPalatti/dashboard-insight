---
/**
 * Casca estática (zero JS): cabeçalho, seções, rodapé e metodologia.
 * Só o que reage ao recorte vira ilha React:
 *  - client:load    → filtros, trilho de comandas, KPIs (acima da dobra) e o painel do agente
 *                     (leve: a conversa em si carrega sob demanda, mas a barra, o botão
 *                     flutuante e o Ctrl+K funcionam desde o primeiro clique)
 *  - client:visible → gráficos e tabelas (hidratam ao rolar)
 * Moldura, título e dica fixa de cada painel ficam aqui (ui/Panel.astro), fora das ilhas:
 * saem no HTML do build e não somem atrás do skeleton enquanto o JS não chega.
 */
import Base from "@/layouts/Base.astro";
import AgentDock from "@/components/agent/AgentDock";
import AlertsPanel from "@/components/AlertsPanel";
import BreakdownTable from "@/components/BreakdownTable";
import FilterBar from "@/components/FilterBar";
import HeatmapChart from "@/components/HeatmapChart";
import KpiStrip from "@/components/KpiStrip";
import OrdersTable from "@/components/OrdersTable";
import StagesChart from "@/components/StagesChart";
import StoreScatter from "@/components/StoreScatter";
import TopBarStatus from "@/components/TopBarStatus";
import TrendChart from "@/components/TrendChart";
import OpsLogo from "@/components/ui/OpsLogo.astro";
import Panel from "@/components/ui/Panel.astro";

const apiUrl = (import.meta.env.PUBLIC_API_URL ?? "http://localhost:8000").replace(/\/$/, "");
const repoUrl = "https://github.com/EmersonPalatti/dashboard-insight";
---

<Base
  title="Central de Operações"
  description="Painel de operação de delivery com alertas e agente de insights sobre o recorte filtrado. 369 mil pedidos reais do Delivery Center."
>
  <!-- #page: o painel do agente no mobile deixa tudo isto inerte (folha modal) -->
  <div id="page">
    <!-- no escuro o vinho (#26060F) quase some no campo (#111): um fio de wine-raised marca a borda da faixa -->
    <header class="bg-wine text-white dark:border-b dark:border-wine-raised">
      <!-- abaixo de sm a barra vira uma linha só (~56px): subtítulo e links somem; o agente abre pelo botão flutuante -->
      <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6 sm:py-3.5 lg:py-4.5 lg:flex-nowrap">
        <div class="flex min-w-0 flex-col justify-center gap-1 sm:gap-1.5 lg:flex-1">
          <div class="flex items-center gap-2.5">
            <OpsLogo size={28} class="text-on-wine" />
            <h1 class="header-reveal-title shrink-0 text-[1.35rem] leading-none font-bold tracking-tight text-white [font-stretch:90%] sm:text-[1.45rem]">
              Central de Operações
            </h1>
          </div>
          <!-- Subtítulo e telemetria do recorte com stagger reveal suave -->
          <div class="header-reveal-sub max-sm:hidden flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[0.82rem] text-on-wine/90">
            <span class="truncate">Alertas e agente sobre o recorte filtrado</span>
            <span class="inline-flex items-center gap-1.5 rounded-full border border-on-wine/15 bg-wine-raised/60 px-2.5 py-0.5 text-[0.76rem] font-medium text-on-wine dark:bg-white/10">
              <span>Delivery Center</span>
              <span class="opacity-50">·</span>
              <span class="tabular-nums">jan–abr 2021</span>
              <span class="opacity-50">·</span>
              <span class="tabular-nums font-semibold text-white">368.990 pedidos</span>
            </span>
          </div>
        </div>
        <div class="no-print flex shrink-0 flex-wrap items-center gap-1.5">
          <a class="max-sm:hidden rounded-card px-3 py-1.5 text-[0.88rem] text-on-wine transition-colors duration-(--duration-quick) ease-(--ease-smooth-out) hover:bg-wine-raised hover:text-white" href={`${apiUrl}/docs`} target="_blank" rel="noopener">API (Swagger)</a>
          <span class="ml-1"><TopBarStatus client:load /></span>
        </div>
      </div>
    </header>

    <div data-filter-bar class="no-print sticky top-0 z-20 border-b border-rule bg-surface">
      <div class="mx-auto max-w-[1440px] px-4 py-2 sm:px-6">
        <FilterBar client:load />
      </div>
    </div>

    <main class="mx-auto grid max-w-[1440px] grid-cols-[minmax(0,1fr)] gap-5 px-4 pt-5 pb-16 max-lg:pb-24 sm:px-6">
      <!--
        Trilho de comandas no topo: as comandas penduradas lado a lado e a aberta numa faixa larga.
        KPIs e tendência ganham a largura toda logo abaixo. O agente fica fora da grade (AgentDock).
      -->
      <div id="comandas" class="min-w-0 scroll-mt-16 lg:scroll-mt-28">
        <AlertsPanel client:load />
      </div>

      <KpiStrip client:load />

      <Panel title="Tendência"><TrendChart client:visible /></Panel>

      <!--
        Âncoras dos gráficos que provam uma comanda ("Ver no gráfico"). Ficam na casca porque as
        ilhas só hidratam ao aparecer: o alvo da rolagem precisa existir antes delas.
      -->
      <div class="grid gap-5 lg:grid-cols-2">
        <div id="grafico-etapas" tabindex="-1" class="evidence-anchor grid min-w-0">
          <Panel title="Onde o tempo vai, por hub" hint="Mediana de cada etapa, sem pedidos presos. Clique numa barra para filtrar o hub.">
            <StagesChart client:visible />
          </Panel>
        </div>
        <div id="grafico-dia-hora" tabindex="-1" class="evidence-anchor grid min-w-0">
          <Panel title="Dia × hora"><HeatmapChart client:visible /></Panel>
        </div>
      </div>

      <div class="grid gap-5 xl:grid-cols-2">
        <div id="grafico-lojas" tabindex="-1" class="evidence-anchor grid min-w-0">
          <Panel title="Lojas: volume × problema" hint="Cada ponto é uma loja com 30+ pedidos; tamanho = GMV. Use a seleção retangular para filtrar um grupo.">
            <StoreScatter client:visible />
          </Panel>
        </div>
        <Panel title="Ranking do recorte"><BreakdownTable client:visible /></Panel>
      </div>

      <Panel title="Pedidos do recorte"><OrdersTable client:visible /></Panel>
    </main>

    <footer class="border-t border-rule bg-surface">
      <div class="mx-auto grid max-w-[1440px] gap-6 px-4 py-7 text-[0.88rem] text-muted sm:px-6 md:grid-cols-3">
        <div>
          <p class="text-pretty cond text-[0.8rem] font-bold text-ink">Dados</p>
          <p class="text-pretty">
            <a class="underline decoration-rule underline-offset-4" href="https://www.kaggle.com/datasets/nosbielcs/brazilian-delivery-center" target="_blank" rel="noopener">Delivery Center: Food &amp; Goods orders in Brazil</a> (Kaggle). Nomes de lojas vêm anonimizados no dataset.
          </p>
        </div>
        <div>
          <p class="text-pretty cond text-[0.8rem] font-bold text-ink">Como os números são calculados</p>
          <p class="text-pretty">
            Horários convertidos de UTC para Brasília. SLA: food ≤ 60 min, goods ≤ 120 min. Pedidos com ciclo &gt; 4h contam como
            "presos" e ficam fora de medianas e SLA. Valores &gt; R$ 5 mil ficam fora do GMV.
          </p>
        </div>
        <div>
          <p class="text-pretty cond text-[0.8rem] font-bold text-ink">Stack</p>
          <p class="text-pretty">Astro + ilhas React, ECharts, Nanostores, TanStack Query/Table/Virtual · FastAPI, Pydantic, DuckDB sobre Parquet.</p>
          <p class="text-pretty mt-1"><a class="underline decoration-rule underline-offset-4" href={repoUrl} target="_blank" rel="noopener">Código</a></p>
        </div>
      </div>
    </footer>
  </div>

  <AgentDock client:load />
</Base>
